<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>de.cuioss</groupId>
        <artifactId>cui-quarkus-parent</artifactId>
        <version>1.7.7</version>
        <relativePath />
    </parent>
    <groupId>de.planmarshall</groupId>
    <artifactId>pm-mcp-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <!-- Must be declared: <inceptionYear> is inherited, and the license plugin binds the
         copyright ${year} to it. Without this, a project reports cui-parent-pom's 2022
         and every -Ppre-commit run restamps every header. -->
    <inceptionYear>2026</inceptionYear>
    <name>pm-mcp-parent</name>
    <description>Parent POM of every module of plan-marshall-mcp: the Java release, the licence, the
        quality-gate recipes, the managed third-party versions, and the deployment to the package
        registry of the organisation plan-marshall.
    </description>
    <url>https://github.com/plan-marshall/pm-mcp-parent/</url>
    <!-- Overrides the Apache-2.0 license inherited from cui-parent-pom. -->
    <licenses>
        <license>
            <name>Proprietary - all rights reserved</name>
            <url>https://github.com/plan-marshall/pm-mcp-parent/blob/main/LICENSE.md</url>
            <distribution>manual</distribution>
        </license>
    </licenses>
    <scm>
        <url>https://github.com/plan-marshall/pm-mcp-parent/</url>
        <connection>
            scm:git:https://github.com/plan-marshall/pm-mcp-parent.git
        </connection>
        <developerConnection>
            scm:git:https://github.com/plan-marshall/pm-mcp-parent/
        </developerConnection>
        <tag>HEAD</tag>
    </scm>
    <issueManagement>
        <url>https://github.com/plan-marshall/pm-mcp-parent/issues</url>
        <system>GitHub Issues</system>
    </issueManagement>
    <!-- One registry: every artifact of every repository is deployed to the GitHub Packages Maven registry of
         the organisation plan-marshall and to no other place. pm.repository is the name of the deploying
         repository; it has no default, each repository sets it in its root POM, and the enforcer rule
         deploy-only-to-the-organisation-registry fails the build without it. The site is never deployed. -->
    <distributionManagement>
        <repository>
            <id>plan-marshall</id>
            <name>GitHub Packages of plan-marshall</name>
            <url>https://maven.pkg.github.com/plan-marshall/${pm.repository}</url>
        </repository>
        <snapshotRepository>
            <id>plan-marshall</id>
            <name>GitHub Packages of plan-marshall</name>
            <url>https://maven.pkg.github.com/plan-marshall/${pm.repository}</url>
        </snapshotRepository>
        <site>
            <id>local-only</id>
            <url>file://${maven.multiModuleProjectDirectory}/target/site-deploy</url>
        </site>
    </distributionManagement>

    <properties>
        <!-- Read by cui-parent-pom's compiler <release> and by both javadoc configurations of
             cui-java-parent (pluginManagement and the pre-commit check-javadocs execution) -->
        <maven.compiler-plugin.release>25</maven.compiler-plugin.release>
        <!-- Overrides the SonarCloud organisation inherited from cui-parent-pom -->
        <sonar.organization>plan-marshall</sonar.organization>
        <version.quarkus-mcp-server>2.0.2</version.quarkus-mcp-server>
        <version.picocli>4.7.7</version.picocli>
        <version.commonmark>0.30.0</version.commonmark>
        <version.lsp4j>1.0.0</version.lsp4j>
        <version.jgit>7.8.0.202609011348-r</version.jgit>
        <version.native-maven-plugin>1.1.14</version.native-maven-plugin>
        <!-- Default empty argLine for JaCoCo compatibility - JaCoCo overrides it when active -->
        <argLine />
        <!-- Publishing to Maven Central is switched off for every module and every profile (see the
             central-publishing-maven-plugin override in build/plugins and the enforcer rule). -->
        <skipPublishing>true</skipPublishing>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- version.quarkus is inherited from cui-quarkus-parent. The BOM is restated here,
                 FIRST, so that it wins the smallrye-config convergence over the BOMs below; the
                 organisation's quarkus-alignment CI job fails on a split Quarkus line. -->
            <dependency>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${version.quarkus}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>de.cuioss</groupId>
                <artifactId>java-ee-orthogonal</artifactId>
                <version>${version.cui.parent}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>de.cuioss</groupId>
                <artifactId>java-ee-10-bom</artifactId>
                <version>${version.cui.parent}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Quarkiverse MCP Server -->
            <dependency>
                <groupId>io.quarkiverse.mcp</groupId>
                <artifactId>quarkus-mcp-server-bom</artifactId>
                <version>${version.quarkus-mcp-server}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Libraries named by the verification gates -->
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli</artifactId>
                <version>${version.picocli}</version>
            </dependency>
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli-codegen</artifactId>
                <version>${version.picocli}</version>
            </dependency>
            <dependency>
                <groupId>org.commonmark</groupId>
                <artifactId>commonmark</artifactId>
                <version>${version.commonmark}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.lsp4j</groupId>
                <artifactId>org.eclipse.lsp4j</artifactId>
                <version>${version.lsp4j}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jgit</groupId>
                <artifactId>org.eclipse.jgit</artifactId>
                <version>${version.jgit}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- cui-parent-pom skips maven-deploy-plugin, because its release profiles publish with the
                     central-publishing extension instead. Here the plain deploy is the only publishing, so it
                     is switched on again. The three alt* parameters pin the target against a target given on
                     the command line (-DaltDeploymentRepository and its two variants): configuration in the
                     POM takes precedence over a user property. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <configuration>
                        <skip>false</skip>
                        <altDeploymentRepository>plan-marshall::https://maven.pkg.github.com/plan-marshall/${pm.repository}</altDeploymentRepository>
                        <altReleaseDeploymentRepository>plan-marshall::https://maven.pkg.github.com/plan-marshall/${pm.repository}</altReleaseDeploymentRepository>
                        <altSnapshotDeploymentRepository>plan-marshall::https://maven.pkg.github.com/plan-marshall/${pm.repository}</altSnapshotDeploymentRepository>
                    </configuration>
                </plugin>
                <!-- Never part of a build here. Should a profile of cui-parent-pom (release, release-snapshot)
                     be activated all the same, it publishes nothing. -->
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <configuration>
                        <skipPublishing>true</skipPublishing>
                        <autoPublish>false</autoPublish>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.graalvm.buildtools</groupId>
                    <artifactId>native-maven-plugin</artifactId>
                    <version>${version.native-maven-plugin}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <showDeprecation>true</showDeprecation>
                        <failOnWarning>true</failOnWarning>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <systemPropertyVariables>
                            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                            <maven.home>${maven.home}</maven.home>
                            <quarkus.test.arg-line>@{argLine}</quarkus.test.arg-line>
                        </systemPropertyVariables>
                        <useModulePath>false</useModulePath>
                        <useFile>false</useFile>
                        <trimStackTrace>false</trimStackTrace>
                        <enableAssertions>true</enableAssertions>
                        <argLine>@{argLine} -XX:+IgnoreUnrecognizedVMOptions -Djava.awt.headless=true</argLine>
                        <forkedProcessTimeoutInSeconds>0</forkedProcessTimeoutInSeconds>
                        <forkedProcessExitTimeoutInSeconds>60</forkedProcessExitTimeoutInSeconds>
                        <useSystemClassLoader>false</useSystemClassLoader>
                        <reuseForks>false</reuseForks>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <configuration>
                        <systemPropertyVariables>
                            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                            <maven.home>${maven.home}</maven.home>
                        </systemPropertyVariables>
                        <useModulePath>false</useModulePath>
                        <useFile>false</useFile>
                        <trimStackTrace>false</trimStackTrace>
                        <enableAssertions>true</enableAssertions>
                        <argLine>@{argLine} -XX:+IgnoreUnrecognizedVMOptions -Djava.awt.headless=true</argLine>
                        <useSystemClassLoader>false</useSystemClassLoader>
                        <reuseForks>false</reuseForks>
                        <includes>
                            <include>**/*IT.java</include>
                        </includes>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- cui-parent-pom loads central-publishing-maven-plugin as a build extension, which removes the
                 deploy goal from the lifecycle and publishes to Maven Central in its place. Declared here
                 without the extension, the plugin takes no part in the build, and the plain deploy to the
                 organisation registry is the deploy phase again. -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <extensions>false</extensions>
            </plugin>
            <!-- Artifacts leave only through the organisation's registry: the build fails when pm.repository
                 is unset, when the effective deployment target of a module is not
                 https://maven.pkg.github.com/plan-marshall/<repository>, or when the Maven Central publishing
                 is not skipped. Every module of every repository inherits the rule. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>deploy-only-to-the-organisation-registry</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireProperty>
                                    <property>pm.repository</property>
                                    <regex>[a-z0-9][a-z0-9-]*</regex>
                                    <message>pm.repository must be the name of the deploying repository; the root POM of the repository sets it.</message>
                                    <regexMessage>pm.repository must be a repository name of the organisation plan-marshall.</regexMessage>
                                </requireProperty>
                                <requireProperty>
                                    <property>project.distributionManagement.repository.url</property>
                                    <regex>https://maven\.pkg\.github\.com/plan-marshall/[a-z0-9][a-z0-9-]*</regex>
                                    <message>No release repository: artifacts are deployed to the registry of the organisation plan-marshall only.</message>
                                    <regexMessage>The release repository must be https://maven.pkg.github.com/plan-marshall/&lt;repository&gt;.</regexMessage>
                                </requireProperty>
                                <requireProperty>
                                    <property>project.distributionManagement.snapshotRepository.url</property>
                                    <regex>https://maven\.pkg\.github\.com/plan-marshall/[a-z0-9][a-z0-9-]*</regex>
                                    <message>No snapshot repository: artifacts are deployed to the registry of the organisation plan-marshall only.</message>
                                    <regexMessage>The snapshot repository must be https://maven.pkg.github.com/plan-marshall/&lt;repository&gt;.</regexMessage>
                                </requireProperty>
                                <requireProperty>
                                    <property>skipPublishing</property>
                                    <regex>true</regex>
                                    <message>skipPublishing must be true: nothing is published to Maven Central.</message>
                                    <regexMessage>skipPublishing must be true: nothing is published to Maven Central.</regexMessage>
                                </requireProperty>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Overrides the parent's OpenRewrite recipe list; identical except for the two
             exclusions documented inline. combine.children="override" is required: Maven appends
             inherited activeRecipes, so a single recipe cannot be removed any other way. Keep the
             list in sync with cui-java-parent by hand. -->
        <profile>
            <id>pre-commit</id>
            <build>
                <plugins>
                    <!-- Replaces the parent's Apache-2.0 header template with the proprietary
                         header and sets the licensor named in LICENSE.md as owner; the year stays inherited
                         from cui-java-parent. -->
                    <plugin>
                        <groupId>com.mycila</groupId>
                        <artifactId>license-maven-plugin</artifactId>
                        <configuration>
                            <properties>
                                <owner>Oliver Wolff</owner>
                            </properties>
                            <licenseSets combine.children="override">
                                <licenseSet>
                                    <header>${maven.multiModuleProjectDirectory}/src/license/header.txt</header>
                                    <includes>
                                        <include>src/main/java/**</include>
                                        <include>src/test/java/**</include>
                                    </includes>
                                </licenseSet>
                            </licenseSets>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.openrewrite.maven</groupId>
                        <artifactId>rewrite-maven-plugin</artifactId>
                        <configuration>
                            <activeRecipes combine.children="override">
                                <recipe>org.openrewrite.java.format.AutoFormat</recipe>
                                <recipe>org.openrewrite.java.format.NormalizeLineBreaks</recipe>
                                <recipe>org.openrewrite.java.format.RemoveTrailingWhitespace</recipe>
                                <recipe>de.cuioss.rewrite.format.AnnotationNewlineFormat</recipe>
                                <recipe>de.cuioss.rewrite.logging.CuiLoggerStandardsRecipe</recipe>
                                <recipe>de.cuioss.rewrite.logging.CuiLogRecordPatternRecipe</recipe>
                                <recipe>de.cuioss.rewrite.logging.InvalidExceptionUsageRecipe</recipe>
                                <!-- UpgradeToJava21 (and UpgradeToJava25, which contains it) intentionally
                                     excluded: it rewrites the compiler release back to 21, and its chain
                                     reaches RenameUnderscoreIdentifier, which turns Java 22+ unnamed
                                     variables (catch (X _)) into non-compiling source. A Java-8-to-21
                                     migration has nothing to do on a Java 25 codebase (as in API-Sheriff). -->
                                <recipe>org.openrewrite.java.migrate.RemoveSecurityManager</recipe>
                                <!-- JavaUtilAPIs intentionally excluded, as in the parent: its UseMapOf
                                     produces non-compiling output. -->
                                <recipe>org.openrewrite.java.OrderImports</recipe>
                                <recipe>org.openrewrite.java.RemoveUnusedImports</recipe>
                                <recipe>org.openrewrite.java.ShortenFullyQualifiedTypeReferences</recipe>
                                <recipe>org.openrewrite.java.testing.junit5.JUnit5BestPractices</recipe>
                                <recipe>org.openrewrite.java.testing.junit5.RemoveTryCatchFailBlocks</recipe>
                                <recipe>org.openrewrite.staticanalysis.EqualsAvoidsNull</recipe>
                                <recipe>org.openrewrite.staticanalysis.NoPrimitiveWrappersForToStringOrCompareTo</recipe>
                                <recipe>org.openrewrite.staticanalysis.SimplifyBooleanExpression</recipe>
                                <recipe>org.openrewrite.staticanalysis.UnnecessaryParentheses</recipe>
                            </activeRecipes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>coverage</id>
            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>org.jacoco</groupId>
                            <artifactId>jacoco-maven-plugin</artifactId>
                            <executions>
                                <execution>
                                    <id>prepare-agent</id>
                                    <goals>
                                        <goal>prepare-agent</goal>
                                    </goals>
                                    <configuration>
                                        <append>true</append>
                                        <destFile>${project.build.directory}/jacoco.exec</destFile>
                                        <!-- @QuarkusTest classes are instrumented by quarkus-jacoco,
                                             which writes into the same data file (application.properties) -->
                                        <exclClassLoaders>*QuarkusClassLoader</exclClassLoaders>
                                    </configuration>
                                </execution>
                                <execution>
                                    <id>report</id>
                                    <phase>test</phase>
                                    <goals>
                                        <goal>report</goal>
                                    </goals>
                                    <configuration>
                                        <outputDirectory>${project.build.directory}/site/jacoco</outputDirectory>
                                        <formats>
                                            <format>XML</format>
                                            <format>HTML</format>
                                        </formats>
                                    </configuration>
                                </execution>
                            </executions>
                        </plugin>
                    </plugins>
                </pluginManagement>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
            <properties>
                <sonar.coverage.jacoco.xmlReportPaths>
                    ${project.build.directory}/site/jacoco/jacoco.xml,
                    ../target/site/jacoco/jacoco.xml
                </sonar.coverage.jacoco.xmlReportPaths>
            </properties>
        </profile>
    </profiles>
</project>
